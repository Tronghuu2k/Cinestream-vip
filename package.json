{
  "name": "rosi-cinema-app",
  "version": "2.0.0",
  "description": "ROSI CINEMA 2.0 Stable - Android and TV responsive streaming app",
  "scripts": {
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "assets:generate": "npx capacitor-assets generate --android --iconBackgroundColor '#141414' --iconBackgroundColorDark '#141414' --splashBackgroundColor '#141414' --splashBackgroundColorDark '#141414'",
    "vendor:copy": "mkdir -p www/vendor && cp node_modules/hls.js/dist/hls.min.js www/vendor/hls.min.js",
    "test": "node test-source.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "hls.js": "^1.5.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
